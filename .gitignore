# ── Python ────────────────────────────────────────────────────────
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ─────────────────────────────────────────
.venv/
venv/
env/
.venv*/

# ── IDE / Editor ──────────────────────────────────────────────────
.*/
!.gitignore
!.github/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── ML / Data ─────────────────────────────────────────────────────
checkpoints/
data/tokenized/*.pt
# committed evidence — cited in docs/speedpass/2026-10-26-official-suite.md
!data/tokenized/samples_*.pt
data/*.json
!data/tokenizer.json
!data/fineweb_samples.jsonl

# ── Project-specific ──────────────────────────────────────────────
.codegraph
.kimchi
.opencode
.omo
.claude
.pi-subagents

# ── Logs / Reports ────────────────────────────────────────────────
*.log
# committed gate transcripts — cited evidence
!results/*.log
ruff_cache/
.ruff_cache/

# ── AI agent context (regenerated per-session) ────────────────────
CONTEXT.md
temp/

# ── Session handoff (never commit) ───────────────────────────────
HANDOFF.md
diag_*.py

# ── Stray patch / editor-backup files ──────────────────────────────
*.patch
*.orig
